# ==============================================================================
# OpenTranslator - Official .gitignore
# Canonical Git Exclusion Rules for Clean Product Repository
# ==============================================================================

# --- AI & IDE Configuration ---
.agents/
skills_whitepaper/

# --- Dependencies & Binaries ---
node_modules/
**/node_modules/
bin/
*.pdb

# --- Heavy / Portable Binaries (> 100MB / GitHub limits) ---
loaders/inject.exe
resources/godot/gdre_tools.exe
resources/godot/GodotMonoDecompNativeAOT.dll

# --- Python / C# Build Caches & Ephemeral Files ---
**/__pycache__/
*.pyc
*.pyo
*.obj
*.suo
*.user

# --- Runtime Logs & Process Locks ---
*.log
logs/
data/logs/
data/openT.log
data/server.pid
data/temp_chrome_profile/

# --- Local Databases & Persistent Caches ---
*.db*
*.sqlite*
data/global_cache.db*
data/cache/

# --- Runtime Sessions, Staging, Transactions & Jobs ---
data/staging/
data/transactions/
data/sessions/
data/jobs/
data/evidence/
data/qa_artifacts/
scratch/

# --- User Game Library Runtime Metadata ---
gameLib/*.gljson
gameLib/*_pic

# --- Game Executables, Archives & Raw Game Data ---
# (Product contains translation engine only; games belong in OpenTranslator-Lab)
*.rpa
*.pak
*.unity3d
*.assets
*.bundle
*.rgss3a
*.rgss2a
*.rgssad
*.rpyc

# --- Game Saves & State Dumps ---
*.save
*.sav
*.rpgsave
*.qsave
*.asave

# --- Gameplay Captures & Media Artifacts ---
*.mp4
*.webm
*.avi
*.mkv

# --- Tool / Knowledge-Graph Artifacts ---
# FASE 10: `graphify-out/` na RAIZ nao casava com a regra antiga, que so
# cobria `archives/analysis/graphify-out/cache/`. Sao 7,72 MB de graph.json
# gerado, reproduzivel com `graphify update .`, e nada no produto o consome.
graphify-out/
archives/analysis/graphify-out/
*.graph.json

# --- Audit Manifests ---
# FASE 10: `archives/audits/_open_translator_audit/` ja estava excluido, mas
# o manifesto de cleanup ao lado (`cleanup_manifest_before.json`, 7,46 MB) nao
# casava com nenhuma regra. E evidencia de auditoria, nao produto.
archives/audits/*.json
archives/audits/**/*.json

# --- Laboratory & Historical Bloat ---
_open_translator_audit/
archives/audits/_open_translator_audit/
archives/analysis/graphify-out/cache/
archives/backups/
archives/logs/
archives/sessions/
archives/staging/
archives/transactions/

# Historical/generated material stays in the external, hash-verified cleanup archive.
/archives/
/docs/analysis/
/UNITY_GAMEPLAY_EVIDENCE/
/src/data/
/src/Tool/
/Tool/
