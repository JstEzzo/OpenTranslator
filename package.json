{
  "name": "opentranslator",
  "version": "1.0.0",
  "description": "Universal AI-Powered Game Translation Suite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/index.js",
    "test:security": "node tests/index.js --security",
    "test:unit": "node tests/index.js --unit",
    "test:bail": "node tests/index.js --bail",
    "legacy:renpy": "node tests/validate_renpy_certification.js",
    "legacy:mz": "node tests/validate_mz_certification.js",
    "smoke": "OpenTranslator.exe --smoke-test",
    "lint": "node tools/repoLint.js",
    "audit:success": "node tools/successAudit.js",
    "verify": "npm run lint && npm run audit:success && npm test",
    "package:portable": "node tools/package_release.js"
  },
  "private": true,
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "ws": "^8.21.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
